# ----------------------------------------------------------------------
# 1. SECURITY: DISABLE DIRECTORY LISTING
# ----------------------------------------------------------------------
# Prevents users from seeing your file structure if an index file is missing.
Options -Indexes

# ----------------------------------------------------------------------
# 2. SECURITY: BLOCK ACCESS TO SENSITIVE FILES/FOLDERS
# ----------------------------------------------------------------------
# Forbid access to backend, database, and configuration folders
RewriteEngine On
RewriteRule ^(database|backend|node_modules|logs)(\/|$) - [F,L]

# Forbid access to sensitive files
<FilesMatch "^(\.env|\.git|package(-lock)?\.json|README\.md|composer\.(json|lock))$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ----------------------------------------------------------------------
# 3. HTTPS ENFORCEMENT & PUBLIC ROUTING
# ----------------------------------------------------------------------
# Force HTTPS (Essential for business credibility and SEO)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Silently route all traffic to the /public folder
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

# ----------------------------------------------------------------------
# 4. PERFORMANCE: GZIP COMPRESSION
# ----------------------------------------------------------------------
# Compresses text-based files to reduce loading time
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# ----------------------------------------------------------------------
# 5. PERFORMANCE: BROWSER CACHING
# ----------------------------------------------------------------------
# Tells browsers to store images/CSS locally to speed up repeat visits
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>